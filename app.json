{
  "expo": {
    "name": "MediMatch",
    "slug": "MediMatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/medimatch-logo.png",
    "scheme": "medimatch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bergman34.MediMatch"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/medimatch-logo.png",
          "resizeMode": "contain",
          "imageWidth": 150,
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b1af1f5-7213-44cf-ab41-5e4911fdda00"
      }
    }
  }
}
